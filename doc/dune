; Regenerate using dune build @gendune --auto-promote

; Dune ignores dot-directories; .scripts has to be declared for the
; serve-website rule below to see its script.

(data_only_dirs .scripts)

(include dune.inc)

(rule
 (alias dummytest)
 (package liquidsoap)
 (action
  (run %{bin:liquidsoap} --version)))

(executable
 (name gen_dune)
 (preprocess
  (pps ppx_string))
 (libraries re liquidsoap_build_tools)
 (modules gen_dune))

(rule
 (alias gendune)
 (target dune.inc.gen)
 (deps
  (source_tree ../src/libs)
  (source_tree .))
 (action
  (progn
   (with-stdout-to
    dune.inc.gen
    (run ./gen_dune.exe))
   (format-dune-file dune.inc.gen dune.inc.gen.formatted))))

(rule
 (alias gendune)
 (action
  (diff dune.inc dune.inc.gen.formatted)))

; Preview the documentation website locally: builds the reference, then serves
; savonet/website against this checkout with live reload on doc/content.
;
;   dune build @doc/serve-website
;
; Set LIQUIDSOAP_WEBSITE to use your own checkout of the site.

(rule
 (alias serve-website)
 (deps
  reference.md
  reference-extras.md
  reference-deprecated.md
  protocols.md
  settings.md
  ../dune-project
  .scripts/serve-website.sh)
 (action
  (run sh .scripts/serve-website.sh)))

(rule
 (alias doc)
 (target liquidsoap.1)
 (deps
  no-pandoc
  (:liquidsoap_man liquidsoap.1.md))
 (action
  (ignore-outputs
   (system
    "pandoc -s -t man %{liquidsoap_man} -o liquidsoap.1 || cp no-pandoc liquidsoap.1"))))

(install
 (section man)
 (package liquidsoap)
 (files liquidsoap.1))
