#!/usr/bin/make -f

DESTDIR := debian/tmp

%:
	dh $@

override_dh_autoreconf:
	/bin/true

override_dh_auto_configure:
	/bin/true

# Built outside fakeroot: its stale inode cache can report a recycled inode's
# old file type, which dune rejects when digesting targets.
override_dh_auto_build:
	rm -rf _build/install
	LIQUIDSOAP_BUILD_TARGET=posix LIQUIDSOAP_INSTALL_NO_OPTIONAL_FAIL=true dune build @install --release

override_dh_auto_test:
	/bin/true

override_dh_auto_install:
	dune install --relocatable --prefix $(DESTDIR)
	dh_install

override_dh_auto_clean:
	/bin/true
