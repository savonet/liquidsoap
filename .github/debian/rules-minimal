#!/usr/bin/make -f

DESTDIR := debian/tmp

%:
	dh $@

override_dh_autoreconf:
	/bin/true

override_dh_auto_configure:
	/bin/true

# Built outside fakeroot: see rules.
override_dh_auto_build:
	LIQUIDSOAP_BUILD_TARGET=posix LIQUIDSOAP_INSTALL_NO_OPTIONAL_FAIL=true dune build @install --release

override_dh_auto_test:
	/bin/true

override_dh_auto_install:
	dune install --prefix /usr --destdir $(DESTDIR)
	rm -rf $(DESTDIR)/usr/share/liquidsoap-lang/libs/extra
	dh_install

override_dh_auto_clean:
	/bin/true
