opam-version: "2.0"
synopsis: "A Unicode library (Windows cross-compilation)"
description: """
Camomile is a Unicode library for OCaml. Camomile provides Unicode character
type, UTF-8, UTF-16, UTF-32 strings, conversion to/from about 200 encodings,
collation and locale-sensitive case mappings, and more. The library is currently
designed for Unicode Standard 3.2."""
maintainer: "romain.beauxis@gmail.com"
authors: "Yoriyuki Yamagata"
license: "LGPL-2.0-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://github.com/ocaml-community/Camomile"
bug-reports: "https://github.com/ocaml-community/Camomile/issues"
depends: [
  "ocaml-windows" {>= "4.13"}
  "dune" {>= "3.23"}
  "dune-site"
  "dune-site-windows"
  "camlp-streams"
  "camlp-streams-windows"
]
build: [
  [
    "env"
    "CAMOMILE_CONFIG=env"
    "CAMOMILE_PREFIX=%{prefix}%/windows-sysroot"
    "dune"
    "build"
    "-p"
    "camomile"
    "-x"
    "windows"
    "-j"
    jobs
    "@install"
  ]
  ["rm" "%{name}%.install"]
]
install: [
  [
    "env"
    "CAMOMILE_CONFIG=env"
    "CAMOMILE_PREFIX=%{prefix}%/windows-sysroot"
    "dune"
    "install"
    "-x"
    "windows"
    "-p"
    "camomile"
  ]
]
dev-repo: "git+https://github.com/ocaml-community/Camomile.git"
url {
  src: "https://github.com/ocaml-community/Camomile/archive/refs/tags/v2.1.0.tar.gz"
  checksum: [
    "md5=35c450853b72e286bef9b75ae4821621"
    "sha512=fff70942e1866c5ad180a9de392a153809db7858f6d9f1067cd88db8b23b03643d09666abf09e6fae3d4da99f44570158b83170104cee68fdd5c1fc41b7c3e7b"
  ]
}
