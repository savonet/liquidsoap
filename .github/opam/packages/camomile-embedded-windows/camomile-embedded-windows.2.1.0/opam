opam-version: "2.0"
synopsis: "Camomile Unicode library with data files embedded at compile time (Windows cross-compilation)"
description: """
camomile-embedded provides the same API as camomile but with all Unicode
data files embedded directly into the library. Programs using this package
have no runtime filesystem dependency on data files."""
maintainer: "romain.beauxis@gmail.com"
authors: "Yoriyuki Yamagata"
license: "LGPL-2.0-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://github.com/ocaml-community/Camomile"
bug-reports: "https://github.com/ocaml-community/Camomile/issues"
depends: [
  "ocaml-windows" {>= "4.13"}
  "dune" {>= "3.23"}
  "camomile" {= version}
  "camomile-windows" {= version}
  "crunch" {build & >= "4.1.0"}
]
build: [
  [
    "dune"
    "build"
    "-p"
    "camomile-embedded"
    "-x"
    "windows"
    "-j"
    jobs
    "@install"
  ]
  ["rm" "%{name}%.install"]
]
install: [
  ["dune" "install" "-x" "windows" "-p" "camomile-embedded"]
]
dev-repo: "git+https://github.com/ocaml-community/Camomile.git"
url {
  src: "https://github.com/ocaml-community/Camomile/archive/refs/tags/v2.1.0.tar.gz"
  checksum: [
    "md5=35c450853b72e286bef9b75ae4821621"
    "sha512=fff70942e1866c5ad180a9de392a153809db7858f6d9f1067cd88db8b23b03643d09666abf09e6fae3d4da99f44570158b83170104cee68fdd5c1fc41b7c3e7b"
  ]
}
