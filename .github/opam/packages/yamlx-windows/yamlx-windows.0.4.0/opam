opam-version: "2.0"
synopsis: "Pure-OCaml YAML 1.2/1.1 parser with a lossless, comment-preserving AST (Windows cross-compilation)"
description: """
YAMLx is a pure-OCaml YAML 1.2 library with no C bindings or external
runtime dependencies. The parsed node tree preserves scalar styles, flow
vs. block collection style, tags, anchors, source positions and comments,
and a typed-value resolver applies the YAML 1.2 JSON schema."""
maintainer: "romain.beauxis@gmail.com"
authors: "Martin Jambon <martin@mjambon.com>"
license: "AGPL-3.0-only"
homepage: "https://github.com/mjambon/yamlx"
bug-reports: "https://github.com/mjambon/yamlx/issues"
depends: [
  "ocaml-windows" {>= "4.14.0"}
  "dune" {>= "3.20"}
  "ppx_deriving" {build}
  "ppx_deriving-windows"
]
build: [
  [
    "dune"
    "build"
    "-p"
    "yamlx"
    "-x"
    "windows"
    "-j"
    jobs
    "@install"
  ]
  ["rm" "%{name}%.install"]
]
install: [
  ["dune" "install" "-x" "windows" "-p" "yamlx"]
]
dev-repo: "git+https://github.com/mjambon/yamlx.git"
url {
  src: "https://github.com/mjambon/yamlx/releases/download/0.4.0/yamlx-0.4.0.tbz"
