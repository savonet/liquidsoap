; Snapshot tests for the language pipeline, see README.md.
;
; To update the expected output after an intentional change:
;   dune build @lang_snapshot --auto-promote
;
; After adding or removing a case, regenerate the rules first:
;   dune build @gendune --auto-promote

(include dune.inc)

(executable
 (name snapshot)
 (modules snapshot)
 (flags
  (:standard
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_values))
 (libraries
  liquidsoap-lang.ast
  liquidsoap-lang.data
  liquidsoap-lang.parser
  liquidsoap-lang.prelude
  liquidsoap-lang.reducer
  liquidsoap-lang.types
  liquidsoap-lang.values
  liquidsoap_core_encoder_types
  liquidsoap_ffmpeg_formats_dummy
  liquidsoap_core_formats
  liquidsoap_lang
  liquidsoap_tooling
  re
  sedlex))

(executable
 (name gen_dune)
 (libraries liquidsoap_build_tools)
 (modules gen_dune))

(rule
 (alias gendune)
 (deps
  (source_tree cases)
  (source_tree cases_canonical)
  (source_tree cases_analysis))
 (target dune.inc.gen)
 (action
  (progn
   (with-stdout-to
    dune.inc.gen
    (run ./gen_dune.exe))
   (format-dune-file dune.inc.gen dune.inc.gen.formatted))))

(rule
 (alias gendune)
 (action
  (diff dune.inc dune.inc.gen.formatted)))

; The full standard library's typing environment, for the analysis suite.

(rule
 (targets analysis_stdlib.types analysis_stdlib.log)
 (deps
  ../../src/bin/liquidsoap.exe
  (:stdlib ../../src/libs/stdlib.liq)
  (source_tree ../../src/libs))
 (action
  (with-stdout-to
   analysis_stdlib.log
   (run
    ../../src/bin/liquidsoap.exe
    --stdlib
    %{stdlib}
    --cache-js-stdlib
    analysis_stdlib.types))))
