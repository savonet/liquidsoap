# Regression test for the metadata of a skipped track surviving in a nested
# switch.
#
# When a source is preempted mid-track, `on_leave` skips its track and clears
# its latest metadata, so that re-selecting it does not announce a track that
# will never resume. `clear_last_metadata` is also called by the frame
# machinery at every track mark, so it cannot propagate to the selection:
# `skip` has to carry the clearing. Without that, a source nested inside a
# switch (here `music` inside `autodj`) kept the metadata of the track it was
# skipping and replayed it on re-selection, adding a spurious `on_metadata`.
#
# The sine mp3 files are generated by ffmpeg in the dune build.

log.level := 3

music = single("skipped_track_music.mp3")
autodj = fallback([music])
program = request.queue(id="program")
b = blank()
b.composition_type := "live"

radio =
  fallback(
    [program.{track_sensitive = false}, autodj.{track_sensitive = false}, b]
  )

pushed = ref(false)

def check() =
  if null.defined(music.last_metadata()) then test.fail() else test.pass() end
end

radio.on_metadata(
  synchronous=true,
  fun (m) ->
    begin
      if
        m["title"] == "music0" and not pushed()
      then
        pushed := true
        program.push(request.create("skipped_track_program.mp3"))
      elsif
        m["title"] == "program"
      then
        thread.run(delay=0.5, check)
      end
    end
)

output.dummy(fallible=true, radio)
