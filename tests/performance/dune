(executable
 (name gen_bigrecord)
 (flags
  (:standard -open Liquidsoap_core -open Liquidsoap_lang_ast))
 (preprocess
  (pps ppx_string))
 (libraries mem_usage liquidsoap_core liquidsoap-lang.ast liquidsoap_lang)
 (modules gen_bigrecord))

(rule
 (alias perftest)
 (target big-record.liq)
 (deps
  (:gen_bigrecord ./gen_bigrecord.exe))
 (action
  (run %{gen_bigrecord} %{target})))

(rule
 (alias perftest)
 (deps
  (:liquidsoap ../../src/bin/liquidsoap.exe)
  (source_tree ../../src/libs)
  (:small_record ./test_small-record.liq)
  (:big_record ./big-record.liq)
  (:erathostenes ./test_erathostenes.liq)
  (:performance test_performance.liq)
  (:memory test_memory.liq)
  ../test.liq)
 (action
  (progn
   (run %{liquidsoap} %{small_record})
   ; big-record.liq is generated, so it cannot include the helpers itself.
   (run %{liquidsoap} %{performance} %{big_record})
   (run %{liquidsoap} %{erathostenes})
   (run %{liquidsoap} %{memory}))))
