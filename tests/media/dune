; HLS output conformance: copied H.264 with B-frames in three variants, AAC-LC
; and HE-AAC, a 2 s GOP whose key frames fall after or before each boundary.

(rule
 (alias mediatest)
 (package liquidsoap)
 (target hls-field-after.ts)
 (action
  (run
   ffmpeg
   -hide_banner
   -loglevel
   error
   -f
   lavfi
   -i
   "testsrc2=duration=62:size=320x180:rate=25"
   -f
   lavfi
   -i
   "sine=frequency=440:duration=62:sample_rate=44100"
   -filter_complex
   "[0:v]split=3[a][b][c];[b]scale=240:136[b2];[c]scale=160:90[c2]"
   -map
   "[a]"
   -map
   "[b2]"
   -map
   "[c2]"
   -map
   1:a
   -map
   1:a
   -c:v
   libx264
   -pix_fmt
   yuv420p
   -bf
   3
   -g
   50
   -keyint_min
   50
   -sc_threshold
   0
   -c:a:0
   aac
   -c:a:1
   libfdk_aac
   -profile:a:1
   aac_he
   -ac
   2
   %{target})))

(rule
 (alias mediatest)
 (package liquidsoap)
 (target hls-field-before.ts)
 (action
  (run
   ffmpeg
   -hide_banner
   -loglevel
   error
   -f
   lavfi
   -i
   "testsrc2=duration=62:size=320x180:rate=25"
   -f
   lavfi
   -i
   "sine=frequency=440:duration=62:sample_rate=44100"
   -filter_complex
   "[0:v]split=3[a][b][c];[b]scale=240:136[b2];[c]scale=160:90[c2]"
   -map
   "[a]"
   -map
   "[b2]"
   -map
   "[c2]"
   -map
   1:a
   -map
   1:a
   -c:v
   libx264
   -pix_fmt
   yuv420p
   -bf
   3
   -g
   1000
   -force_key_frames
   "expr:gte(t,n_forced*2-0.28)"
   -sc_threshold
   0
   -c:a:0
   aac
   -c:a:1
   libfdk_aac
   -profile:a:1
   aac_he
   -ac
   2
   %{target})))

