; Replacements for a few Stdlib functions, e.g. a tail-recursive List.map.
;
; This is the one library that must stay unwrapped: its whole purpose is to
; shadow `Stdlib.List` for every module that links it, which a wrapped library
; cannot do.

(library
 (name stdlib)
 (public_name liquidsoap-lang.stdlib)
 (wrapped false))
