; Self-contained data structures and services the rest of the language builds
; on: JSON, documentation, method maps, positions-free utilities, the runtime
; error type, and the generated build configuration.
;
; Kept wrapped because `Doc`, `Startup` and `Utils` collide with modules of the
; same name in liquidsoap_core; consumers get them unqualified through
; `-open Liquidsoap_lang_data`.

(menhir
 (modules json_parser))

(rule
 (target fakeroot)
 (deps
  (glob_files_rec %{workspace_root}/.git/**)
  (sandbox preserve_file_kind))
 (action
  (progn
   (run mkdir -p fakeroot)
   (run cp -rf %{workspace_root}/.git/ fakeroot/.git))))

(rule
 (target git_sha)
 (deps fakeroot)
 (action
  (with-stdout-to
   %{target}
   (with-accepted-exit-codes
    (or 0 128)
    (run git -C fakeroot rev-parse --short HEAD)))))

(rule
 (target build_config.ml)
 (deps git_sha)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let is_snapshot = %{env:IS_SNAPSHOT=true}\n")
    (echo "let version = \"%{version:liquidsoap-lang}\"\n")
    (echo "let version_len = String.length version\n")
    (echo "let parsed_sha = String.trim \"")
    (cat git_sha)
    (echo "\"\n")
    (echo "let parsed_sha_len = String.length parsed_sha\n")
    (echo "let dune_sha_len = 7\n")
    (echo "let git_sha = match is_snapshot, parsed_sha with \n")
    (echo "  | false, _ | _, \"\" -> None\n")
    (echo
     "  | _, _ when dune_sha_len <= version_len && dune_sha_len <= parsed_sha_len && String.sub parsed_sha 0 dune_sha_len = String.sub version (version_len - dune_sha_len) dune_sha_len -> None\n")
    (echo "  |  _, s -> Some s\n")
    (echo
     "let git_sha = match Sys.getenv_opt \"LIQ_GIT_SHA\" with None -> git_sha | Some v -> Some v \n")
    (echo
     "let version = version ^ (if not is_snapshot then \"\" else (match git_sha with None -> \"+dev\" | Some sha -> \"+git@\" ^ sha))\n")
    (echo
     "let version = match Sys.getenv_opt \"LIQUIDSOAP_BUILD_VERSION\" with None -> version | Some v -> v \n")
    (echo "let ext_exe = \"%{ocaml-config:ext_exe}\"\n")
    (echo "let architecture = \"%{ocaml-config:architecture}\"\n")
    (echo "let host = \"%{ocaml-config:host}\"\n")
    (echo "let target = \"%{ocaml-config:target}\"\n")
    (echo "let system = \"%{ocaml-config:system}\"\n")
    (echo "let ocamlopt_cflags = \"%{ocaml-config:ocamlopt_cflags}\"\n")
    (echo "let native_c_compiler = \"%{ocaml-config:native_c_compiler}\"\n")
    (echo
     "let native_c_libraries = \"%{ocaml-config:native_c_libraries}\"\n")))))

(library
 (name liquidsoap_lang_data)
 (public_name liquidsoap-lang.data)
 (flags
  (:standard -open Liquidsoap_lang_prelude))
 (preprocess
  (pps sedlex.ppx ppx_hash))
 (libraries
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  fileutils
  menhirLib
  re
  str
  unix))
