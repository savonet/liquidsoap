; Modules with no dependencies of their own that every other liquidsoap-lang
; library needs. Kept wrapped because `Pos` and `Lang_string` collide with
; modules of the same name in liquidsoap_core; consumers get them unqualified
; through `-open Liquidsoap_lang_prelude`.

(library
 (name liquidsoap_lang_prelude)
 (public_name liquidsoap-lang.prelude)
 (preprocess
  (pps ppx_hash))
 (libraries base ppx_hash.runtime-lib re str threads.posix unix))
