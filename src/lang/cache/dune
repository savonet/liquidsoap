; The on-disk caches: the marshalling store itself, its maintenance, and the
; typechecking cache keyed on parsed terms and the builtin environment.

(library
 (name liquidsoap_lang_cache)
 (public_name liquidsoap-lang.cache)
 (wrapped false)
 (flags
  (:standard -open Liquidsoap_lang_prelude -open Liquidsoap_lang_data))
 (preprocess
  (pps ppx_hash))
 (libraries
  liquidsoap-lang.ast
  liquidsoap-lang.data
  liquidsoap-lang.prelude
  liquidsoap-lang.values
  unix))
