(env
 (dev
  (flags
   (:standard -w -7-9 -warn-error -33))))

(data_only_dirs .scripts)

(library
 (name liquidsoap_js)
 (public_name liquidsoap-js)
 (optional)
 (modules)
 (js_of_ocaml
  (javascript_files runtime.js))
 (preprocess
  (pps js_of_ocaml-ppx))
 (flags
  (:standard -open Liquidsoap_lang_prelude))
 (libraries liquidsoap-lang.prelude liquidsoap_lang liquidsoap_tooling))

(install
 (files index.html)
 (section share)
 (package liquidsoap-js))

(rule
 (target playground.bundle.js)
 (enabled_if %{bin-available:npm})
 (deps
  (:script .scripts/bundle-playground.sh)
  .scripts/playground/package.json
  .scripts/playground/package-lock.json)
 (action
  (run sh %{script} %{target})))

(rule
 (target playground.bundle.js)
 (enabled_if
  (not %{bin-available:npm}))
 (action
  (write-file
   %{target}
   "console.error('Playground bundle not available - npm was not installed during build');")))

(executable
 (name interactive_js)
 (modes js)
 (optional)
 (modules interactive_js)
 (flags
  (:standard
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_values))
 (js_of_ocaml
  ; The lang has no effect handlers of its own; the ones OCaml 5 links in are
  ; never performed here. Saying so keeps js_of_ocaml from asking for the cps
  ; backend, which costs 15% bundle size for support nothing uses.
  (flags
   (:standard --effects=disabled))
  (javascript_files filesystem.js))
 (preprocess
  (pps ppx_string js_of_ocaml-ppx))
 (libraries
  liquidsoap-lang.ast
  liquidsoap-lang.data
  liquidsoap-lang.parser
  liquidsoap-lang.reducer
  liquidsoap-lang.types
  liquidsoap-lang.values
  liquidsoap_lang
  liquidsoap_tooling
  sedlex
  liquidsoap_js))

(rule
 (target filesystem.js)
 (enabled_if
  (not %{bin-available:js_of_ocaml}))
 (action
  (write-file %{target} "console.log(\"no js_of_ocaml available!\")")))

(rule
 (target filesystem.js)
 (enabled_if %{bin-available:js_of_ocaml})
 (deps
  ./stdlib_js.liq
  (glob_files ../libs/*.liq))
 (action
  (run js_of_ocaml build-fs -I . -I ../libs -o %{target} %{deps})))

(rule
 (alias serve-playground)
 (deps
  interactive_js.bc.js
  index.html
  playground.bundle.js
  .scripts/serve-playground.sh)
 (action
  (run sh .scripts/serve-playground.sh)))
