(rule
 (targets
  swresample_available
  swresample_c_flags
  swresample_c_flags.sexp
  swresample_c_library_flags.sexp
  swresample_versions)
 (deps (universe) avutil_available avcodec_available)
 (action
  (run
   ./detect.exe
   detect
   --os-type
   %{os_type}
   --context
   %{context_name}
   --profile
   %{profile}
   --requires
   "avutil avcodec"
   swresample
   "libswresample >= 5.3.100, libavutil >= 59.39.100"
   -Wall
   -Wextra)))

(rule
 (target tests.inc)
 (deps
  avutil_available
  avcodec_available
  av_available
  avfilter_available
  avdevice_available
  swscale_available
  swresample_available)
 (action
  (with-stdout-to
   %{target}
   (run
    ./detect.exe
    stanzas
    %{dep:tests.dune}
    avutil
    avcodec
    av
    avfilter
    avdevice
    swscale
    swresample))))
