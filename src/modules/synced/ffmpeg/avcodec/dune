(rule
 (alias install)
 (package ffmpeg-avcodec)
 (enabled_if
  (not
   (= %{env:LIQUIDSOAP_INSTALL_NO_OPTIONAL_FAIL=false} true)))
 (action
  (with-stdin-from
   ../detect/avcodec_available
   (run ../detect/detect.exe check avcodec))))

(library
 (name avcodec)
 (public_name ffmpeg-avcodec)
 (synopsis "Bindings to ffmpeg's avcodec library")
 (enabled_if
  (= %{read:../detect/avcodec_available} "true"))
 (foreign_stubs
  (language c)
  (names avcodec_stubs)
  (extra_deps ../detect/avcodec_versions)
  (flags
   (:include ../detect/avcodec_c_flags.sexp)))
 (c_library_flags
  (:include ../detect/avcodec_c_library_flags.sexp))
 (public_headers avcodec_stubs.h)
 (libraries ffmpeg-avutil))

(rule
 (targets
  codec_capabilities.ml
  codec_capabilities_stubs.h
  codec_properties.ml
  codec_properties_stubs.h
  hw_config_method.ml
  hw_config_method_stubs.h
  packet_side_data_type.ml
  packet_side_data_type_stubs.h
  codec_id.ml
  codec_id_stubs.h)
 (deps ../detect/avcodec_versions)
 (enabled_if
  (= %{read:../detect/avcodec_available} "true"))
 (action
  (run
   ../gen_code/gen_code.exe
   "%{cc}"
   avcodec
   %{read-lines:../detect/avcodec_c_flags})))
