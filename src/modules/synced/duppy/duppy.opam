opam-version: "2.0"
version: "1.0.0"
synopsis: "Task scheduler for OCaml 5 domains"
maintainer: ["The Savonet Team <contact@liquidsoap.info>"]
authors: ["The Savonet Team <contact@liquidsoap.info>"]
license: "GPL-2.0-or-later"
homepage: "https://github.com/savonet/ocaml-duppy"
bug-reports: "https://github.com/savonet/ocaml-duppy/issues"
depends: [
  "ocaml" {>= "5.5"}
  "dune" {>= "3.23"}
  "re" {>= "1.11.0"}
  "odoc" {with-doc}
]
build: [
  [
    "dune"
    "build"
    "-p"
    name
