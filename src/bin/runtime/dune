(library
 (name liquidsoap_runtime)
 (preprocess
  (pps ppx_string))
 (flags
  (:standard -open Liquidsoap_core))
 (libraries
  liquidsoap_core
  liquidsoap_optionals
  liquidsoap_builtins
  liquidsoap_tooling
  (select
   runner.ml
   from
   (winsvc -> runner.winsvc.ml)
   (-> runner.default.ml))))
