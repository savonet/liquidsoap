; Sources.
;
; The source class every operator inherits from, tracks, and the language
; values that wrap sources and clocks.
;
; liquidsoap_core_source.mli lists what this library exports. A module that is
; not in it is private to this directory.

(library
 (name liquidsoap_core_source)
 (flags
  (:standard
   -w
   -9
   -alert
   --deprecated
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_cache
   -open
   Liquidsoap_lang
   -open
   Liquidsoap_core_utils
   -open
   Liquidsoap_core_stream
   -open
   Liquidsoap_core_media
   -open
   Liquidsoap_core_encoder
   -open
   Liquidsoap_core_clock))
 (preprocess
  (pps ppx_string))
 (libraries
  mm
  cron
  dtools
  domain_shims
  dune-build-info
  duppy
