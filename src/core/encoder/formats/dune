; Format values and their builders.
;
; What %mp3(...) and friends describe, and how their parameters become that
; description, need no encoding library: a process that only typechecks
; scripts builds formats to type them.

(library
 (name liquidsoap_encoder_formats)
 (public_name liquidsoap.encoder_formats)
 (wrapped false)
 ; Linking it is what registers the builders.
 (library_flags (-linkall))
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang))
 (libraries
  liquidsoap-lang
  liquidsoap-lang.ast
  liquidsoap-lang.data
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.values
  encoder_types
  liquidsoap_ffmpeg_formats
  liquidsoap_core_formats))
