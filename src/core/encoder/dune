; Encoders.
;
; The encoder framework, one module per output format, and the language
; bindings that turn %mp3(...) and friends into encoder formats.
;
; liquidsoap_core_encoder.mli lists what this library exports. A module that is
; not in it is private to this directory.

(library
 (name liquidsoap_core_encoder)
 (flags
  (:standard
   -w
   -9
   -alert
   --deprecated
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_cache
   -open
   Liquidsoap_lang
   -open
   Liquidsoap_core_utils
   -open
   Liquidsoap_core_stream
   -open
   Liquidsoap_core_media))
 (preprocess
  (pps ppx_string))
 (libraries
  mm
  re
  metadata
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.data
  liquidsoap-lang.values
  liquidsoap-lang.ast
  liquidsoap-lang.parser
  liquidsoap-lang.reducer
  liquidsoap-lang.cache
  liquidsoap-lang
  liquidsoap_core_utils
  liquidsoap_core_stream
  liquidsoap_core_media)
 (library_flags -linkall))
