; Container formats, converters and the decoder framework.
;
; AVI/WAV readers and writers, sample-rate and channel-layout converters,
; and the Decoder plug registry. The concrete decoders live in decoders/,
; above request/, because they register metadata resolvers into requests.
;
; liquidsoap_core_media.mli lists what this library exports. A module that is
; not in it is private to this directory.

(library
 (name liquidsoap_core_media)
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_cache
   -open
   Liquidsoap_lang
   -open
   Liquidsoap_core_utils
   -open
   Liquidsoap_core_stream))
 (libraries
  mm
  dtools
  magic-mime
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.data
  liquidsoap-lang.values
  liquidsoap-lang.ast
  liquidsoap-lang.parser
  liquidsoap-lang.reducer
  liquidsoap-lang.cache
  liquidsoap-lang
  liquidsoap_core_utils
  liquidsoap_core_stream))
