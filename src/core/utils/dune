(env
 (release
  (ocamlopt_flags
   (:standard -w -9-58 -alert --deprecated -O2)))
 (_
  (ocamlopt_flags
   (:standard -w -58))
  (flags
   (:standard -w -9 -alert --deprecated))))

(include_subdirs unqualified)

(rule
 (target liquidsoap_paths.posix.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "type mode = [ `Default | `Standalone | `Posix ]\n\n")
    (echo "let mode = `Posix\n")
    (echo
     "let rundir () = \"%{env:LIQUIDSOAP_RUN_DIR=/var/run/liquidsoap}\"\n")
    (echo "let rundir_descr = rundir ()\n")
    (echo
     "let logdir () = \"%{env:LIQUIDSOAP_LOG_DIR=/var/log/liquidsoap}\"\n")
    (echo "let logdir_descr = logdir ()\n")
    (echo
     "let liq_libs_dir () = \"%{env:LIQUIDSOAP_LIBS_DIR=/usr/share/liquidsoap/libs}\"\n")
    (echo "let liq_libs_dir_descr = liq_libs_dir ()\n")
    (echo
     "let bin_dir () = \"%{env:LIQUIDSOAP_BIN_DIR=/usr/share/liquidsoap/bin}\"\n")
    (echo "let bin_dir_descr = bin_dir ()\n")
    (echo "let user_cache_override () = None\n")
    (echo "let user_cache_override_descr = \"$HOME/.cache/liquidsoap\"\n")
    (echo
     "let system_cache_override () = Some \"%{env:LIQUIDSOAP_CACHE_DIR=/var/cache/liquidsoap}\"\n")
    (echo
     "let system_cache_override_descr = \"%{env:LIQUIDSOAP_CACHE_DIR=/var/cache/liquidsoap}\"\n")))))

(rule
 (target liquidsoap_paths.ml)
 (action
  (copy liquidsoap_paths.%{env:LIQUIDSOAP_BUILD_TARGET=default}.ml %{target})))

; Leaf utilities.
;
; Logging, threads, processes, sockets, time, string handling, build-time
; paths and the global configuration tree. Depends on no other core library:
; anything here must make sense without knowing what a frame or a source is.
;
; liquidsoap_core_utils.mli lists what this library exports. A module that is
; not in it is private to this directory.

(library
 (name liquidsoap_core_utils)
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_cache
   -open
   Liquidsoap_lang))
 (libraries
  camomile-embedded
  cry
  dtools
  dune-build-info
  dune-site
  duppy
  liquidsoap-lang
  liquidsoap-lang.ast
  liquidsoap-lang.cache
  liquidsoap-lang.console
  liquidsoap-lang.data
  liquidsoap-lang.prelude
  liquidsoap_memtrace
  metadata
  re
  stdlib_utils
  threads.posix
  str
  unix)
 (foreign_stubs
  (language c)
  (names unix_c)))
