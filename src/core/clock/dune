; Clocks.
;
; Clocks animate the sources attached to them by ticking: each tick asks
; every animated source to produce one frame. Nothing else drives data
; production. The specification is in spec/.

(library
 (name clock)
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang))
 (libraries
  dtools
  liquidsoap-lang
  liquidsoap-lang.data
  liquidsoap-lang.prelude
  liquidsoap_core_utils
  duppy
  duppy.stdlib_utils
  threads.posix
  liquidsoap_core_stream))
