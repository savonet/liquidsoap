; Clocks.
;
; Clocks animate the sources attached to them by ticking: each tick asks
; every animated source to produce one frame. Nothing else drives data
; production.
;
; liquidsoap_core_clock.mli lists what this library exports. A module that is
; not in it is private to this directory.

(library
 (name liquidsoap_core_clock)
 (flags
  (:standard
   -w
   -9
   -alert
   --deprecated
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_cache
   -open
   Liquidsoap_lang
   -open
   Liquidsoap_core_utils
   -open
   Liquidsoap_core_stream))
 (preprocess
  (pps ppx_string))
 (libraries
  mm
  cron
  dtools
  domain_shims
  dune-build-info
  duppy
  liquidsoap_memtrace
  menhirLib
  camomile.lib
  curl
  cry
  re
  uri
  metadata
  mem_usage
  magic-mime
  stdlib_utils
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.data
  liquidsoap-lang.values
  liquidsoap-lang.ast
  liquidsoap-lang.parser
  liquidsoap-lang.reducer
  liquidsoap-lang.cache
  liquidsoap-lang
  liquidsoap_core_utils
  liquidsoap_core_stream))
