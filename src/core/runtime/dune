; The Lang API.
;
; Core's Lang: the language's Lang extended with everything an operator
; needs to register itself, plus the module namespaces and the hooks that
; liquidsoap-lang calls back into. Everything above this layer registers
; operators and builtins; nothing below it may.
;
; liquidsoap_core_runtime.mli lists what this library exports. A module that is
; not in it is private to this directory.

(library
 (name liquidsoap_core_runtime)
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_lang_reducer
   -open
   Liquidsoap_lang_cache
   -open
   Liquidsoap_core_utils
   -open
   Liquidsoap_core_stream
   -open
   Liquidsoap_core_media
   -open
   Liquidsoap_core_encoder
   -open
   Liquidsoap_core_clock
   -open
   Liquidsoap_core_source
   -open
   Liquidsoap_core_request))
 (preprocess
  (pps ppx_string))
 (libraries
  dtools
  re
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.data
  liquidsoap-lang.values
  liquidsoap-lang.ast
  liquidsoap-lang.parser
  liquidsoap-lang.reducer
  liquidsoap-lang.cache
  liquidsoap-lang
  liquidsoap_core_utils
  liquidsoap_core_stream
  liquidsoap_core_media
  liquidsoap_core_encoder
  liquidsoap_core_clock
  liquidsoap_core_source
  liquidsoap_core_request))
