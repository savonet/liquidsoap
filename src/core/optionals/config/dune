; Optional dependencies.
;
; liquidsoap_optionals is the library that pulls in whichever optional plugin
; libraries are actually available. dune's (select ...) is the only way to say
; "link this library if it exists", so there is one select per dependency, and
; the module it picks records whether the dependency was found.
;
; All of that -- the selects, the pair of modules behind each one, and the list
; behind liquidsoap.build_config.optionals -- is generated from the single
; table in gen_dune.ml. Add a dependency there, then:
;
;   dune build @gendune --auto-promote

(include dune.inc)

(executable
 (name gen_dune)
 (modules gen_dune))

(rule
 (alias gendune)
 (target dune.inc.gen)
 (action
  (progn
   (with-stdout-to
    dune.inc.gen
    (run ./gen_dune.exe))
   (format-dune-file dune.inc.gen dune.inc.gen.formatted))))

(rule
 (alias gendune)
 (action
  (diff dune.inc dune.inc.gen.formatted)))
