  ffmpeg-avdevice
  ffmpeg-avfilter
  ffmpeg-avutil
  ffmpeg-swresample
  ffmpeg-swscale
  liquidsoap_core
  liquidsoap_ffmpeg_formats
  metadata
  mm
  mm.audio
  mm.base
  mm.image
  mm.video
  re
  threads.posix
  unix)
 (optional))
