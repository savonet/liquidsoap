; A/V markers: a white frame and a beep at the same instant.

(rule
 (target marked.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   "color=c=black:s=320x240:r=25:d=4,drawbox=x=0:y=0:w=320:h=240:color=white:t=fill:enable='between(t,1.6,1.639)'"
   -f
   lavfi
   -i
   "aevalsrc='if(between(t,1.6,1.65),0.8*sin(2*PI*1000*t),0)':s=44100:d=4"
   -pix_fmt
   yuv420p
   -c:v
   libx264
   -g
   25
   -bf
   0
   -c:a
   aac
   %{target})))

(rule
 (target marked_midgop.mp4)
 (deps marked.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -ss
   0.5
   -i
   marked.mp4
   -t
   2
   -c
   copy
   %{target})))

; Live inputs: video 8 s after audio, with markers 2 s into the video; audio
; 2 s before video.

(rule
 (target latevideo.ts)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   "aevalsrc='if(between(t,10,10.05),0.8*sin(2*PI*1000*t),0)':s=44100:d=12"
   -f
   lavfi
   -i
   "color=c=black:s=320x240:r=25:d=4,drawbox=x=0:y=0:w=320:h=240:color=white:t=fill:enable='between(t,2,2.039)'"
   -filter:v
   setpts=PTS+8/TB
   -map
   0:a
   -map
   1:v
   -pix_fmt
   yuv420p
   -c:v
   libx264
   -c:a
   aac
   -f
   mpegts
   %{target})))

(rule
 (target earlyaudio.ts)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   sine=duration=8
   -f
   lavfi
   -i
   testsrc=duration=4:rate=25
   -filter:v
   setpts=PTS+2/TB
   -map
   0:a
   -map
   1:v
   -pix_fmt
   yuv420p
   -c:v
   libx264
   -c:a
   aac
   -f
   mpegts
   %{target})))

; Subtitles with one cue each, at 1 s, 20 min and 30 s.

(rule
 (target sub_short.mkv)
 (deps sub_short.srt)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   anullsrc=r=44100:cl=mono
   -i
   sub_short.srt
   -t
   2
   -map
   0:a
   -map
   1:s
   -c:a
   aac
   -b:a
   32k
   -c:s
   srt
   %{target})))

