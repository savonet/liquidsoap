; Known-complexity checks that need media (spec/tests.md §23): fixtures
; generated with the FFmpeg command line, one rule per check. Run one with
; dune build @ffmpeg_conformance_kc<N>; all of them run in @mediatest.

(executable
 (name conformance)
 (modules conformance)
 (libraries ffmpeg-av ffmpeg-avcodec ffmpeg-avutil ffmpeg-swresample unix))

; B-frame concat set: video only, first DTS about 41.17, 25.2 and 8.17 s.

(rule
 (target bf1.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=20:size=320x180:rate=30
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   30
   -pix_fmt
   yuv420p
   -output_ts_offset
   41.25
   %{target})))

(rule
 (target bf2.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=30:size=320x180:rate=30
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   30
   -pix_fmt
   yuv420p
   -output_ts_offset
   25.267
   %{target})))

(rule
 (target bf3.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=10:size=320x180:rate=30
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   30
   -pix_fmt
   yuv420p
   -output_ts_offset
   8.25
   %{target})))

; Mid-GOP pair: AAC + H.264, a keyframe every second; the second file starts
; 0.6 s before a keyframe.

(rule
 (target gop.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=6:size=320x180:rate=30
   -f
   lavfi
   -i
   sine=frequency=440:duration=6
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   30
   -pix_fmt
   yuv420p
   -c:a
   aac
   %{target})))

(rule
 (target gop4.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=12:size=320x180:rate=30
   -f
   lavfi
   -i
   sine=frequency=440:duration=12
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   120
   -pix_fmt
   yuv420p
   -c:a
   aac
   %{target})))

(rule
 (target midgop.mp4)
 (deps gop.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -i
   gop.mp4
   -ss
   0.4
   -c
   copy
   -copyinkf
   %{target})))

