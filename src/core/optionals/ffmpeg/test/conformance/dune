   -nostdin
   -loglevel
   error
   -i
   midgop.mp4
   -t
   0.4
   -c
   copy
   -copyinkf
   %{target})))

; First keyframe 25 s in, beyond the keyframe wait bound.

(rule
 (target longgop_full.mp4)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=60:size=160x90:rate=30
   -f
   lavfi
