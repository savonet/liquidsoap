   sine=frequency=440:duration=60
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   900
   -keyint_min
   900
   -sc_threshold
   0
   -pix_fmt
   yuv420p
   -c:a
   aac
   %{target})))

