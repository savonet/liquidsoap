(rule
 (alias ffmpeg_conformance_kc1)
 (package liquidsoap)
 (deps
  bf1.mp4
  bf2.mp4
  bf3.mp4
  (package liquidsoap)
  (source_tree ../../../../../libs))
 (action
  (run %{exe:conformance.exe} %{exe:../copy_producer.exe} kc1)))

