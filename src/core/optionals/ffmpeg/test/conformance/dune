; One MPEG-TS stream at 30 fps whose size changes twice.

(rule
 (target fc1.ts)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=2:rate=30:size=320x240
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   30
   -pix_fmt
   yuv420p
   %{target})))

(rule
 (target fc2.ts)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=2:rate=30:size=640x480
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   30
   -pix_fmt
   yuv420p
   %{target})))

(rule
 (target fmtchange.ts)
 (deps fc1.ts fc2.ts)
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat fc1.ts)
    (cat fc2.ts)
    (cat fc1.ts)))))

; H.264 with B-frames in AVI: packets carry a DTS and no PTS, so decoded
; frames carry only a best-effort timestamp.

(rule
 (target besteffort.avi)
 (action
  (run
   ffmpeg
   -nostdin
   -loglevel
   error
   -f
   lavfi
   -i
   testsrc=duration=4:rate=25:size=320x240
   -pix_fmt
   yuv420p
   -c:v
   libx264
   -preset
   ultrafast
   -bf
   2
   -g
   25
   %{target})))

