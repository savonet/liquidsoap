; FFmpeg's content kinds and the %ffmpeg format record, without libav.
;
; Not (optional): the playground and the language server typecheck scripts
; that name ffmpeg tracks on machines with no ffmpeg bindings.

(library
 (name liquidsoap_ffmpeg_formats)
 (public_name liquidsoap.ffmpeg_formats)
 (library_flags (-linkall))
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang))
 (libraries
  liquidsoap-lang
  liquidsoap-lang.ast
  liquidsoap-lang.data
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.values
  encoder_types
  liquidsoap_core_formats))
