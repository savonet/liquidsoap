; The language, as the rest of core sees it.
;
; liquidsoap-lang's modules, re-exported under their short names, with the
; ones core augments replaced by their augmented version: Lang, Modules, Doc,
; Startup. Everything above this layer consumes the language through it and
; never names liquidsoap-lang; everything below it uses liquidsoap-lang
; directly and may not register operators or builtins.

(library
 (name liquidsoap_core_lang)
 (wrapped false)
 (libraries
  dtools
  liquidsoap-lang
  liquidsoap-lang.ast
  liquidsoap-lang.cache
  liquidsoap-lang.data
  liquidsoap-lang.parser
  liquidsoap-lang.prelude
  liquidsoap-lang.reducer
  liquidsoap-lang.types
  liquidsoap-lang.values
  clock
  liquidsoap_core_encoder
  liquidsoap_core_media
  liquidsoap_core_request
  liquidsoap_core_source
  liquidsoap_core_stream
  liquidsoap_core_utils
  re
  unix))
