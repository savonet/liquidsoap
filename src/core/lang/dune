; What a process that only typechecks scripts links.
;
; Everything here computes types and builds nothing: the content formats, the
; encoders' types, ffmpeg's content types over the names a script wrote. A
; liquidsoap that streams implements the same hooks from its own modules, so
; it must not link this library -- Hooks.implement says so.

(library
 (name liquidsoap_core_lang)
 (public_name liquidsoap.core_lang)
 ; Linking it is what implements its hooks, so its initialisers must run.
 (library_flags (-linkall))
 (flags
  (:standard
   -open
   Liquidsoap_lang_prelude
   -open
   Liquidsoap_lang_types
   -open
   Liquidsoap_lang_data
   -open
   Liquidsoap_lang_values
   -open
   Liquidsoap_lang_ast
   -open
   Liquidsoap_lang_parser
   -open
   Liquidsoap_core_formats))
 (libraries
  liquidsoap-lang
  liquidsoap-lang.ast
  liquidsoap-lang.data
  liquidsoap-lang.parser
  liquidsoap-lang.prelude
  liquidsoap-lang.types
  liquidsoap-lang.values
  liquidsoap_core_encoder_types
  liquidsoap_core_formats))
