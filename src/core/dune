; The streaming engine, under one name.
;
; Builtins and optional plugins depend on this library alone. It holds no code:
; it re-exports every core layer, and the language comes through
; liquidsoap_core_lang, never from liquidsoap-lang directly. The layers, each
; a library that may only depend on the ones above it:
;
;   utils stream media encoder clock source request lang
;   net protocols decoders sources outputs operators

(library
 (name liquidsoap_core)
 (modules)
 (libraries
  (re_export liquidsoap_core_formats)
  (re_export liquidsoap_core_utils)
  (re_export liquidsoap_stdlib_wrappers)
  (re_export liquidsoap_core_stream)
  (re_export liquidsoap_core_media)
  (re_export liquidsoap_core_encoder)
  (re_export clock)
  (re_export liquidsoap_core_source)
  (re_export liquidsoap_core_request)
  (re_export liquidsoap_core_lang)
  (re_export liquidsoap_core_net)
  (re_export liquidsoap_core_protocols)
  (re_export liquidsoap_core_decoders)
  (re_export liquidsoap_core_sources)
  (re_export liquidsoap_core_outputs)
  (re_export liquidsoap_core_operators)))
